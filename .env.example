PORT=8080
PUBLIC_URL=http://localhost:8080
DB_PATH=oc-review-bot.db

# GitHub App (see README for click-by-click setup)
GITHUB_APP_ID=
# Either inline PEM or a path — path is recommended.
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_PRIVATE_KEY_PATH=./app-private-key.pem
GITHUB_WEBHOOK_SECRET=

# GitHub OAuth (separate OAuth app; callback is $PUBLIC_URL/auth/github/callback)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Random 32+ bytes; encrypts Zen keys at rest and signs sessions.
SESSION_SECRET=
# Comma-separated GitHub logins that become admins. First user is admin if unset.
ADMIN_GITHUB_LOGINS=

BOT_USERNAME=oc-review-bot
ZEN_DEFAULT_MODEL=opencode/big-pickle
REVIEW_CONCURRENCY=2
REVIEW_TIMEOUT_MINUTES=20
OPENCODE_BIN=opencode2
