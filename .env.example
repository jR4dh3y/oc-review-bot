# Copy to .env for `make run-local`; production must inject these values from
# its secret manager. The application does not load .env by itself.
PORT=8080
PUBLIC_URL=http://localhost:8080
DB_PATH=oc-review-bot.db

# GitHub App (see README for click-by-click setup)
GITHUB_APP_ID=
# Set GITHUB_APP_PRIVATE_KEY or GITHUB_APP_PRIVATE_KEY_PATH. If both are set,
# the non-empty file path takes precedence.
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_PRIVATE_KEY_PATH=./app-private-key.pem
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
# Required immutable numeric GitHub user ID of the installed App account. This
# is used to authenticate durable publication-marker reconciliation.
BOT_GITHUB_ID=

# GitHub OAuth (separate OAuth app; callback is $PUBLIC_URL/auth/github/callback)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Required. Generate 32+ random bytes and retain the value for the life of the
# database; it derives the encryption key for stored Zen API keys.
SESSION_SECRET=
# Required. Comma-separated positive, immutable numeric GitHub user IDs. These
# users administer the dashboard and can request reviews after registering.
ADMIN_GITHUB_IDS=
# Optional. Additional comma-separated positive numeric GitHub user IDs that
# can request reviews after registering, but cannot administer the dashboard.
REVIEWER_GITHUB_IDS=
# Required. Comma-separated positive numeric GitHub App installation IDs and
# repository IDs. A review target must match both allowlists.
ALLOWED_GITHUB_INSTALLATION_IDS=
ALLOWED_GITHUB_REPOSITORY_IDS=
# Do not set ADMIN_GITHUB_LOGINS: a non-empty legacy login allowlist is rejected.

# Mentionable GitHub App login, without a leading @.
BOT_USERNAME=oc-review-bot
# Set true for HTTPS deployments. It defaults from PUBLIC_URL and is rejected
# when false would make an HTTPS session cookie insecure.
COOKIE_SECURE=
# Required. Set a current enabled OpenCode Zen model in provider/model form.
# Find it with the installed OpenCode 2 beta CLI rather than copying a stale ID.
ZEN_DEFAULT_MODEL=
REVIEW_CONCURRENCY=2
REVIEW_TIMEOUT_MINUTES=20
# Cool an eligible key for this many minutes after a Zen quota/rate-limit error.
ZEN_COOLDOWN_MINUTES=60
# Admission controls for paid review capacity. Each value must be at least 1.
USER_REVIEWS_PER_HOUR=6
REPO_REVIEWS_PER_HOUR=30
MAX_ACTIVE_REVIEWS=50

# Required review sandbox paths. The runtime is an absolute, trusted directory
# containing bin/opencode2 and its package files; it is mounted read-only.
OPENCODE_BIN=opencode2
OPENCODE_RUNTIME_DIR=
# Direct path to a trusted Bubblewrap executable, for example /usr/bin/bwrap.
BUBBLEWRAP_BIN=
